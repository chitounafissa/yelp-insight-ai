# Copie ce fichier en ".env" et remplis les vraies valeurs.
# .env ne doit JAMAIS être commité (il est dans .gitignore).

POSTGRES_USER=yelp_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=yelp_insight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://yelp_user:change_me@localhost:5432/yelp_insight

ANTHROPIC_API_KEY=your_anthropic_api_key_here
